# Frontend Environment Configuration
# Copy this to .env.local for local development
# For Vercel deployment, set these in Vercel Dashboard → Settings → Environment Variables

# Local development (backend running on localhost)
# REACT_APP_API_BASE_URL=http://localhost:8000

# Production (HuggingFace Spaces backend)
# Replace YOUR_USERNAME with your HuggingFace username
# Replace YOUR_SPACE_NAME with your Space name
REACT_APP_API_BASE_URL=https://YOUR_USERNAME-YOUR_SPACE_NAME.hf.space
